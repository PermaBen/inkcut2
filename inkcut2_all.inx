<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
  <name>Cut Whole Document…</name>
  <id>org.inkcut2.cut-all</id>
  <param name="scope" type="string" gui-hidden="true">document</param>
  <param name="tolerance" type="float" gui-hidden="true" min="0.001" max="1.0" precision="3">0.02</param>
  <effect needs-live-preview="false">
    <object-type>all</object-type>
    <effects-menu>
      <submenu name="InkCut2"/>
    </effects-menu>
    <menu-tip>Send every visible object of the drawing to the InkCut2 cutting window</menu-tip>
  </effect>
  <script>
    <command location="inx" interpreter="python">inkcut2.py</command>
  </script>
</inkscape-extension>
